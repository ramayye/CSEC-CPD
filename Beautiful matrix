# Read the 5x5 matrix
matrix = [list(map(int, input().split())) for _ in range(5)]

# Find the position of the 1
for i in range(5):
    for j in range(5):
        if matrix[i][j] == 1:
            row, col = i, j
            break

# Calculate the number of moves needed
moves = abs(row - 2) + abs(col - 2)

print(moves)

import math

def die_roll_probability(Y, W):
    max_roll = max(Y, W)  # The highest roll so far
    favorable = 6 - max_roll + 1  # Rolls where Dot wins
    denominator = 6  # Total possibilities
    
    # Reduce fraction
    gcd = math.gcd(favorable, denominator)
    return f"{favorable // gcd}/{denominator // gcd}"

# Input reading
Y, W = map(int, input().split())

# Output result
print(die_roll_probability(Y, W))
